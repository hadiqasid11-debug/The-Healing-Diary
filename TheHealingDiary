<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Healing Diary | A Safe Space</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Poppins:wght@300;400;500&family=Lora:ital@0;1&display=swap" rel="stylesheet">
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #FAF9F6;
            --primary-pastel: #E5D3B3;
            --secondary-pastel: #D7C0AE;
            --text-main: #5C524F;
            --text-light: #8E8071;
            --white: #ffffff;
            --accent: #B79471;
            --transition: all 0.4s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            line-height: 1.6;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        h1, h2, h3, .logo {
            font-family: 'Playfair Display', serif;
        }

        /* --- Navigation --- */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 20px 10%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(250, 249, 246, 0.8);
            backdrop-filter: blur(10px);
            z-index: 1000;
            transition: var(--transition);
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--text-main);
            text-decoration: none;
            letter-spacing: 1px;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 30px;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--text-main);
            font-weight: 400;
            transition: var(--transition);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .nav-links a:hover {
            color: var(--accent);
        }

        /* --- Hero Section --- */
        .hero {
            height: 100vh;
            background: linear-gradient(rgba(255,255,255,0.2), rgba(255,255,255,0.2)), 
                        url('https://images.unsplash.com/photo-1499209974431-9dac3adaf477?ixlib=rb-1.2.1&auto=format&fit=crop&w=1600&q=80');
            background-size: cover;
            background-position: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 0 20px;
        }

        .hero-content {
            animation: fadeInUp 1.5s ease;
        }

        .hero h1 {
            font-size: 4rem;
            margin-bottom: 10px;
            font-weight: 400;
        }

        .hero p {
            font-family: 'Lora', serif;
            font-style: italic;
            font-size: 1.2rem;
            margin-bottom: 30px;
            color: var(--text-light);
        }

        .btn {
            padding: 12px 35px;
            background-color: var(--primary-pastel);
            color: var(--text-main);
            text-decoration: none;
            border-radius: 50px;
            transition: var(--transition);
            border: 1px solid transparent;
            font-size: 0.9rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        .btn:hover {
            background-color: transparent;
            border: 1px solid var(--primary-pastel);
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        }

        /* --- About Section --- */
        .section {
            padding: 100px 10%;
        }

        .about {
            text-align: center;
            max-width: 800px;
            margin: 0 auto;
        }

        .about h2 {
            font-size: 2.5rem;
            margin-bottom: 20px;
        }

        .about p {
            font-family: 'Lora', serif;
            font-size: 1.1rem;
            color: var(--text-light);
        }

        /* --- Search & Filter --- */
        .controls {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            margin-bottom: 50px;
        }

        #blogSearch {
            padding: 10px 20px;
            border-radius: 25px;
            border: 1px solid var(--primary-pastel);
            outline: none;
            width: 300px;
            font-family: inherit;
        }

        .filter-btn {
            background: none;
            border: 1px solid var(--primary-pastel);
            padding: 8px 20px;
            border-radius: 25px;
            cursor: pointer;
            transition: var(--transition);
            color: var(--text-light);
        }

        .filter-btn.active, .filter-btn:hover {
            background: var(--primary-pastel);
            color: var(--text-main);
        }

        /* --- Blog Cards --- */
        .blog-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 40px;
        }

        .blog-card {
            background: var(--white);
            border-radius: 15px;
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 10px 30px rgba(0,0,0,0.03);
            position: relative;
        }

        .blog-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        }

        .blog-img {
            width: 100%;
            height: 250px;
            object-fit: cover;
            transition: var(--transition);
        }

        .blog-card:hover .blog-img {
            transform: scale(1.05);
        }

        .blog-content {
            padding: 25px;
        }

        .category-tag {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--accent);
            margin-bottom: 10px;
            display: block;
        }

        .blog-content h3 {
            margin-bottom: 15px;
            font-size: 1.4rem;
        }

        .blog-content p {
            font-size: 0.9rem;
            color: var(--text-light);
            margin-bottom: 20px;
        }

        .read-more {
            text-decoration: none;
            color: var(--text-main);
            font-weight: 500;
            font-size: 0.85rem;
            border-bottom: 1px solid var(--primary-pastel);
            padding-bottom: 2px;
        }

        /* --- Add Blog Section --- */
        .add-blog-container {
            background: #fff;
            padding: 40px;
            border-radius: 20px;
            margin-top: 50px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.02);
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group input, .form-group textarea, .form-group select {
            width: 100%;
            padding: 12px;
            border: 1px solid #eee;
            border-radius: 8px;
            font-family: inherit;
        }

        /* --- Quote Section --- */
        .quote-section {
            background-color: #F3EEEA;
            text-align: center;
            padding: 120px 20px;
        }

        .quote-section blockquote {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            font-style: italic;
            max-width: 900px;
            margin: 0 auto;
            position: relative;
        }

        .quote-section blockquote::before {
            content: "“";
            font-size: 5rem;
            position: absolute;
            top: -40px;
            left: 50%;
            transform: translateX(-50%);
            color: var(--primary-pastel);
            opacity: 0.5;
        }

        /* --- Footer --- */
        footer {
            background: var(--white);
            padding: 60px 10%;
            text-align: center;
            border-top: 1px solid #f0f0f0;
        }

        .social-links {
            margin-bottom: 30px;
        }

        .social-links a {
            font-size: 1.5rem;
            margin: 0 15px;
            color: var(--text-light);
            transition: var(--transition);
        }

        .social-links a:hover {
            color: var(--accent);
        }

        .copyright {
            font-size: 0.8rem;
            color: var(--text-light);
        }

        /* --- Animations --- */
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* --- Responsive --- */
        @media (max-width: 768px) {
            .hero h1 { font-size: 2.5rem; }
            .nav-links { display: none; }
            .section { padding: 60px 5%; }
            #blogSearch { width: 100%; }
        }
    </style>
</head>
<body>

    <!-- Navigation -->
    <nav>
        <a href="#" class="logo">The Healing Diary</a>
        <ul class="nav-links">
            <li><a href="#home">Home</a></li>
            <li><a href="#blogs">Read Blogs</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>

    <!-- Hero Section -->
    <header class="hero" id="home">
        <div class="hero-content">
            <h1>The Healing Diary</h1>
            <p>A safe place for healing, growth, emotions, and unspoken thoughts.</p>
            <a href="#blogs" class="btn">Read Blogs</a>
        </div>
    </header>

    <!-- About Section -->
    <section class="section about" id="about">
        <h2>Your sanctuary for growth.</h2>
        <p>Whether you're navigating the complexities of overthinking, seeking self-love, or just need a quiet moment of reflection, The Healing Diary is here for you. We believe that every emotion deserves a home and every heart deserves a chance to heal.</p>
    </section>

    <!-- Blog Section -->
    <section class="section" id="blogs">
        <div class="controls">
            <input type="text" id="blogSearch" placeholder="Search for a thought..." onkeyup="searchBlogs()">
            <div class="filter-group">
                <button class="filter-btn active" onclick="filterCategory('all')">All</button>
                <button class="filter-btn" onclick="filterCategory('Self Love')">Self Love</button>
                <button class="filter-btn" onclick="filterCategory('Healing')">Healing</button>
                <button class="filter-btn" onclick="filterCategory('Overthinking')">Overthinking</button>
            </div>
        </div>

        <div class="blog-grid" id="blogGrid">
            <!-- Blog Card 1 -->
            <article class="blog-card" data-category="Self Love">
                <img src="https://images.unsplash.com/photo-1515023115689-589c39d55c70?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Self Love" class="blog-img">
                <div class="blog-content">
                    <span class="category-tag">Self Love</span>
                    <h3>The Art of Being Kind to Yourself</h3>
                    <p>Learning to embrace your flaws is the first step towards true inner peace...</p>
                    <a href="#" class="read-more">Read More</a>
                </div>
            </article>

            <!-- Blog Card 2 -->
            <article class="blog-card" data-category="Healing">
                <img src="https://images.unsplash.com/photo-1494438639946-1ebd1d20bf85?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Healing" class="blog-img">
                <div class="blog-content">
                    <span class="category-tag">Healing</span>
                    <h3>Finding Light in Dark Places</h3>
                    <p>Healing is not a linear journey, but every small step forward counts...</p>
                    <a href="#" class="read-more">Read More</a>
                </div>
            </article>

            <!-- Blog Card 3 -->
            <article class="blog-card" data-category="Overthinking">
                <img src="https://images.unsplash.com/photo-1474418397713-7ded81d07ec2?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="Overthinking" class="blog-img">
                <div class="blog-content">
                    <span class="category-tag">Overthinking</span>
                    <h3>Quiet the Loud Mind</h3>
                    <p>How to manage the overwhelming waves of overthinking in a busy world...</p>
                    <a href="#" class="read-more">Read More</a>
                </div>
            </article>
        </div>

        <!-- Add Post UI -->
        <div class="add-blog-container" id="addBlog">
            <h2 style="margin-bottom: 20px; font-size: 1.8rem;">Add to the Diary</h2>
            <div class="form-group">
                <input type="text" id="postTitle" placeholder="Blog Title">
            </div>
            <div class="form-group">
                <select id="postCategory">
                    <option value="Self Love">Self Love</option>
                    <option value="Healing">Healing</option>
                    <option value="Overthinking">Overthinking</option>
                    <option value="Confidence">Confidence & Growth</option>
                </select>
            </div>
            <div class="form-group">
                <textarea id="postDesc" rows="4" placeholder="Share your thoughts..."></textarea>
            </div>
            <button class="btn" onclick="addBlogPost()">Publish Note</button>
        </div>
    </section>

    <!-- Quote Section -->
    <section class="quote-section">
        <blockquote>
            You are allowed to be both a masterpiece and a work in progress simultaneously.
        </blockquote>
    </section>

    <!-- Footer -->
    <footer id="contact">
        <div class="social-links">
            <a href="#"><i class="fab fa-instagram"></i></a>
            <a href="#"><i class="fab fa-medium"></i></a>
            <a href="#"><i class="far fa-envelope"></i></a>
        </div>
        <p class="copyright">© 2023 The Healing Diary. Softly crafted for your soul.</p>
    </footer>

    <script>
        // Search Functionality
        function searchBlogs() {
            let input = document.getElementById('blogSearch').value.toLowerCase();
            let cards = document.getElementsByClassName('blog-card');

            for (let i = 0; i < cards.length; i++) {
                let title = cards[i].getElementsByTagName('h3')[0].innerText.toLowerCase();
                if (title.includes(input)) {
                    cards[i].style.display = "";
                } else {
                    cards[i].style.display = "none";
                }
            }
        }

        // Filter Functionality
        function filterCategory(category) {
            let cards = document.getElementsByClassName('blog-card');
            let buttons = document.getElementsByClassName('filter-btn');

            // Update button styles
            for (let btn of buttons) {
                btn.classList.remove('active');
                if(btn.innerText === category || (category === 'all' && btn.innerText === 'All')) {
                    btn.classList.add('active');
                }
            }

            // Show/Hide cards
            for (let card of cards) {
                if (category === 'all' || card.getAttribute('data-category') === category) {
                    card.style.display = "block";
                    card.style.animation = "fadeInUp 0.5s ease forwards";
                } else {
                    card.style.display = "none";
                }
            }
        }

        // Add Blog Post Functionality (Simulated)
        function addBlogPost() {
            const title = document.getElementById('postTitle').value;
            const category = document.getElementById('postCategory').value;
            const desc = document.getElementById('postDesc').value;

            if (title === "" || desc === "") {
                alert("Please fill in the fields.");
                return;
            }

            const grid = document.getElementById('blogGrid');
            const newCard = document.createElement('article');
            newCard.className = 'blog-card';
            newCard.setAttribute('data-category', category);

            // Using a default aesthetic image for new posts
            const randomImg = "https://images.unsplash.com/photo-1506784983877-45594efa4cbe?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80";

            newCard.innerHTML = `
                <img src="${randomImg}" alt="New Post" class="blog-img">
                <div class="blog-content">
                    <span class="category-tag">${category}</span>
                    <h3>${title}</h3>
                    <p>${desc.substring(0, 80)}...</p>
                    <a href="#" class="read-more">Read More</a>
                </div>
            `;

            grid.prepend(newCard);

            // Clear inputs
            document.getElementById('postTitle').value = "";
            document.getElementById('postDesc').value = "";
            
            // Scroll to top of grid
            window.location.href = "#blogs";
        }

        // Navbar scroll effect
        window.onscroll = function() {
            const nav = document.querySelector('nav');
            if (window.pageYOffset > 50) {
                nav.style.padding = "10px 10%";
                nav.style.background = "rgba(255, 255, 255, 0.95)";
                nav.style.boxShadow = "0 2px 10px rgba(0,0,0,0.05)";
            } else {
                nav.style.padding = "20px 10%";
                nav.style.background = "rgba(250, 249, 246, 0.8)";
                nav.style.boxShadow = "none";
            }
        };
    </script>
</body>
</html>